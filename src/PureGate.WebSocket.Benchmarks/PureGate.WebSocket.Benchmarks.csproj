<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- A load generator against PureGate.WebSocket and SignalR (docs/PLAN-SERVER.md, Benchmarks). Run only on purpose. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- TC=0 for the load generator and the server it starts: measurements without tiering's warmup. -->
    <TieredCompilation>false</TieredCompilation>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PureGate.WebSocket\PureGate.WebSocket.csproj" />
  </ItemGroup>

</Project>
