{
  "description": "Byte-level test vectors for the PureGate.WebSocket wire protocol (docs/PROTOCOL.md). The .NET and TypeScript test suites both pass every one. A bytes value lists two-digit hex bytes and 'quoted' UTF-8 text, separated by spaces. A frame lists only the fields its kind and flags carry; its payload is the UTF-8 text in json, or the bytes in bytes, or empty when it has neither. An invalid input names the violation it must be rejected with.",
  "errorCodes": [
    "timeout",
    "cancelled",
    "unauthorized",
    "forbidden",
    "unknown_operation",
    "invalid_payload",
    "payload_too_large",
    "overloaded",
    "handler_failed",
    "connection_closed",
    "protocol_error"
  ],
  "varints": {
    "valid": [
      { "bytes": "00", "value": 0 },
      { "bytes": "01", "value": 1 },
      { "bytes": "7f", "value": 127 },
      { "bytes": "80 01", "value": 128 },
      { "bytes": "ff 01", "value": 255 },
      { "bytes": "ac 02", "value": 300 },
      { "bytes": "88 27", "value": 5000 },
      { "bytes": "ff 7f", "value": 16383 },
      { "bytes": "80 80 01", "value": 16384 },
      { "bytes": "80 80 80 80 01", "value": 268435456 },
      { "bytes": "ff ff ff ff 0f", "value": 4294967295 },
      { "bytes": "80 00", "value": 0, "shortest": false }
    ],
    "invalid": [
